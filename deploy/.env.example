# 生产环境变量示例 —— 复制为 .env 并修改
# systemd EnvironmentFile 会读取该文件

# 访问密码（登录页使用）
TIMELINE_PASSWORD=change-me

# Flask session 签名密钥（务必生成一个随机的长字符串）
TIMELINE_SECRET=change-me-to-a-long-random-string

# 启用后 Cookie 仅在 HTTPS 下发送。启用 HTTPS 后设为 1
TIMELINE_COOKIE_SECURE=0

# 登录保持天数
TIMELINE_SESSION_DAYS=30

# Gunicorn worker 数量（默认 = CPU 核数 * 2 + 1）
GUNICORN_WORKERS=4
