# systemd 服务 —— 我们的故事
# 放置到 /etc/systemd/system/timeline.service
# 启动: systemctl enable --now timeline

[Unit]
Description=Timeline (我们的故事) Flask app
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/timeline
# 生产环境务必通过环境变量注入真实密钥与密码
EnvironmentFile=/var/www/timeline/deploy/.env
ExecStart=/var/www/timeline/venv/bin/gunicorn -c deploy/gunicorn.conf.py app:app
Restart=always
RestartSec=5

# 上传大图时占用内存，适当放宽
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
